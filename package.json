{
  "name": "Customer_Loyalty",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/util": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4",
    "hdb": "^2.29.5",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-customersui": "cds watch --open customersui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-tranasactionui": "cds watch --open tranasactionui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-redemptionsui": "cds watch --open redemptionsui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-policiesui": "cds watch --open policiesui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-customui": "cds watch --open customui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": "hana",
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true,
      "destinations": true,
      "workzone": true
    }
  },
  "odata": {
    "version": "v4"
  },
  "service": {
    "CustomerService": {
      "kind": "odata",
      "path": "/odata/v4/customer"
    }
  },
  "lcap": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/customersui",
    "app/tranasactionui",
    "app/redemptionsui",
    "app/policiesui",
    "app/customui",
    "app/redemptionsui"
  ]
}
