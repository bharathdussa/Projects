{
  "welcomeFile": "/index.html",
  "routes": [
    {
      "source": "^/(index\\.html)?$",
      "target": "index.html",
      "localDir": ".",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": false
    }
  ]
}
